# Copy this file to .env.local for local development, and set the same
# values (with production secrets) in your Vercel project's Environment
# Variables settings for the deployed app. See README.md for the full setup
# walkthrough (Neon + Vercel).

# Postgres connection string. On Neon, use the *pooled* connection string
# (the one with "-pooler" in the hostname) so serverless functions can share
# connections safely.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Secret used to sign/encrypt the parent session cookie. Generate a fresh one
# per environment with:
#   openssl rand -base64 32
# Do NOT reuse the value from .env.local (or this file) in production.
SESSION_SECRET=

# Anthropic API key used server-side only (never exposed to the browser) for
# the Claude Haiku writing-evaluation and weekly-summary features, and (Stage
# 2 of the PDF content pipeline) transcribing scanned PDFs with no text
# layer. Get one at https://console.anthropic.com/settings/keys. Leave unset
# to run the app with AI features disabled (kids can still practice; writing
# responses are saved but not auto-graded, and scanned-PDF import fails with
# a clear message, until this is configured).
ANTHROPIC_API_KEY=

# --- PDF content pipeline (docs/architecture/rag-content-pipeline.md) ---
# Optional. Leave all three unset to run with PDF import disabled — the
# Content tab shows an honest "not configured yet" state instead of a
# broken picker button.

# A Google Cloud OAuth 2.0 Client ID (Web application type) and API key,
# used client-side by the Google Picker so a parent can browse and select
# one Drive file at a time. Both are inherently public (the NEXT_PUBLIC_
# prefix ships them to the browser) — that's normal for Picker/OAuth client
# IDs, they are not secrets. Scope requested is drive.file (access limited
# to files the parent explicitly picks, not their whole Drive), which is a
# non-sensitive scope and skips Google's app-verification review.
# Setup: console.cloud.google.com -> new project -> enable "Google Picker
# API" and "Google Drive API" -> Credentials -> create an API key (restrict
# it to the Picker API + your domain) and an OAuth 2.0 Client ID (Web
# application, with your deployed origin as an authorized JavaScript origin).
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Voyage AI API key, used server-side only, for embedding imported PDF
# chunks (voyage-4-lite) so they can be similarity-ranked later. Get one at
# https://dashboard.voyageai.com — the free tier (200M tokens/month as of
# writing) covers this app's whole PDF library. Leave unset to import PDFs
# without embeddings (tag-filtered retrieval still works; nothing else
# breaks — see src/lib/rag/embeddings.ts).
VOYAGE_API_KEY=
